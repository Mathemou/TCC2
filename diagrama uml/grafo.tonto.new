// ============================================================
// AVALIAÇÃO
// ============================================================

/**
 * @pt-br Representa a avaliação de uma habilidade de uma pessoa.
 * @en Represents the assessment of a person's skill.
 */
relator AvaliacaoHabilidade {
    label {
        @en "Skill Assessment"
        @pt-br "Avaliação de Habilidade"
    }

    dataAvaliacao : date
    nivel : NivelHabilidade

    @mediation [1] -- pertenceA -- [0..*] (pessoa) Pessoa
    @mediation [1] -- avalia -- [0..*] (habilidade) Habilidade
}

// ============================================================
// TRATAMENTOS
// ============================================================

/**
 * @pt-br Representa um tratamento disponível no contexto do sistema.
 * @en Represents a treatment available in the system context.
 */
kind Tratamento {
    label {
        @en "Treatment"
        @pt-br "Tratamento"
    }

    nome : string
    descricao : string
}

// ============================================================
// RECOMENDAÇÃO
// ============================================================

/**
 * @pt-br Representa uma recomendação produzida a partir das avaliações.
 * @en Represents a recommendation produced from skill assessments.
 */
relator Recomendacao {
    label {
        @en "Recommendation"
        @pt-br "Recomendação"
    }

    dataRecomendacao : date
    justificativa : string
    prioridade : NivelPrioridade

    @mediation [1] -- destinadaA -- [0..*] (pessoa) Pessoa
    @mediation [1] -- recomenda -- [0..*] (tratamento) Tratamento
    @mediation [1..*] -- baseadaEm -- [0..*] (avaliacao) AvaliacaoHabilidade
}

// ============================================================
// CONHECIMENTO DO GRAFO
// ============================================================

/**
 * @pt-br Relaciona uma habilidade a um tratamento que trabalha com ela.
 * @en Relates a skill to a treatment that works with it.
 */
relator HabilidadeTratamento {
    label {
        @en "Skill Treatment Association"
        @pt-br "Associação de Habilidade e Tratamento"
    }

    @mediation [1] -- envolve -- [0..*] (habilidade) Habilidade
    @mediation [1] -- apontaPara -- [0..*] (tratamento) Tratamento
}

/**
 * @pt-br Representa uma dependência de apoio entre duas habilidades.
 * @en Represents a support dependency between two skills.
 */
relator DependenciaHabilidade {
    label {
        @en "Skill Support Dependency"
        @pt-br "Dependência de Apoio entre Habilidades"
    }

    @mediation [1] -- dependeDe -- [0..*] (habilidadeAnterior) Habilidade
    @mediation [1] -- apoia -- [0..*] (habilidadePosterior) Habilidade
}

/**
 * @pt-br Relaciona um prontuário a uma pessoa.
 * @en Relates a clinical record to a person.
 */
relator ProntuarioPessoa {
    label {
        @en "Clinical Record Association"
        @pt-br "Associação de Prontuário e Pessoa"
    }

    @mediation [1] -- pertenceA -- [0..*] (pessoa) Pessoa
    @mediation [1] -- registra -- [0..*] (prontuario) Prontuario
}

// ============================================================
// TIPOS DE DADOS
// ============================================================

enum NivelHabilidade {
    NaoAvaliado,
    Baixo,
    Moderado,
    Alto
}

enum NivelPrioridade {
    Baixa,
    Media,
    Alta
}
