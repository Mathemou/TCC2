package main

// ============================================================
// ENTIDADES PRINCIPAIS
// ============================================================

/**
 * @pt-br Representa uma pessoa com TEA acompanhada no contexto do sistema.
 * @en Represents a person with ASD monitored in the system context.
 */
kind Pessoa {
    label {
        @en "Person"
        @pt-br "Pessoa"
    }

    nome : string
    dataDeNascimento : date
}


// ============================================================
// PRONTUÁRIO
// ============================================================

/**
 * @pt-br Representa o prontuário associado a uma pessoa.
 * @en Represents the medical/clinical record associated with a person.
 */
kind Prontuario {
    label {
        @en "Medical Record"
        @pt-br "Prontuário"
    }

    identificador : string
}


// ============================================================
// HABILIDADES
// ============================================================

/**
 * @pt-br Representa uma habilidade que pode ser avaliada no contexto
 * do acompanhamento da pessoa.
 *
 * @en Represents a skill that can be assessed in the person's monitoring.
 */
kind Habilidade {
    label {
        @en "Skill"
        @pt-br "Habilidade"
    }

    nome : string
}


/**
 * @pt-br Representa uma habilidade relacionada ao autocuidado.
 * @en Represents a self-care skill.
 */
subkind HabilidadeAutocuidado specializes Habilidade {
    label {
        @en "Self-Care Skill"
        @pt-br "Habilidade de Autocuidado"
    }
}


/**
 * @pt-br Representa uma habilidade relacionada ao desenvolvimento motor.
 * @en Represents a motor skill.
 */
subkind HabilidadeMotora specializes Habilidade {
    label {
        @en "Motor Skill"
        @pt-br "Habilidade Motora"
    }
}


// ============================================================
// HABILIDADES DE AUTOCUIDADO
// ============================================================

/**
 * @pt-br Representa uma habilidade relacionada à alimentação.
 */
subkind Alimentacao specializes HabilidadeAutocuidado {
    label {
        @en "Feeding"
        @pt-br "Alimentação"
    }
}


/**
 * @pt-br Representa a habilidade de realizar higiene corporal.
 */
subkind HigieneCorporal specializes HabilidadeAutocuidado {
    label {
        @en "Body Hygiene"
        @pt-br "Higiene Corporal"
    }
}


/**
 * @pt-br Representa a habilidade de realizar higiene bucal.
 */
subkind HigieneBucal specializes HabilidadeAutocuidado {
    label {
        @en "Oral Hygiene"
        @pt-br "Higiene Bucal"
    }
}


/**
 * @pt-br Representa a habilidade de cuidar dos cabelos.
 */
subkind HigieneCabelos specializes HabilidadeAutocuidado {
    label {
        @en "Hair Hygiene"
        @pt-br "Higiene dos Cabelos"
    }
}


/**
 * @pt-br Representa a habilidade de realizar higiene do rosto.
 */
subkind HigieneRosto specializes HabilidadeAutocuidado {
    label {
        @en "Face Hygiene"
        @pt-br "Higiene do Rosto"
    }
}


/**
 * @pt-br Representa a habilidade de realizar higiene das mãos.
 */
subkind HigieneMaos specializes HabilidadeAutocuidado {
    label {
        @en "Hand Hygiene"
        @pt-br "Higiene das Mãos"
    }
}


/**
 * @pt-br Representa a habilidade relacionada ao vestuário.
 */
subkind Vestuario specializes HabilidadeAutocuidado {
    label {
        @en "Dressing"
        @pt-br "Vestuário"
    }
}


/**
 * @pt-br Representa a habilidade relacionada ao uso de calçados.
 */
subkind Calcados specializes HabilidadeAutocuidado {
    label {
        @en "Footwear"
        @pt-br "Calçados"
    }
}


/**
 * @pt-br Representa a habilidade de utilizar o banheiro.
 */
subkind UsoBanheiro specializes HabilidadeAutocuidado {
    label {
        @en "Toileting"
        @pt-br "Uso do Banheiro"
    }
}


// ============================================================
// HABILIDADES MOTORAS
// ============================================================

/**
 * @pt-br Representa a habilidade de caminhar.
 */
subkind Caminhar specializes HabilidadeMotora {
    label {
        @en "Walking"
        @pt-br "Caminhar"
    }
}


/**
 * @pt-br Representa a habilidade de correr.
 */
subkind Correr specializes HabilidadeMotora {
    label {
        @en "Running"
        @pt-br "Correr"
    }
}


/**
 * @pt-br Representa a habilidade de subir escadas.
 */
subkind SubirEscadas specializes HabilidadeMotora {
    label {
        @en "Climbing Stairs"
        @pt-br "Subir Escadas"
    }
}


/**
 * @pt-br Representa a habilidade de rolar.
 */
subkind Rolar specializes HabilidadeMotora {
    label {
        @en "Rolling"
        @pt-br "Rolar"
    }
}


/**
 * @pt-br Representa a habilidade de sentar.
 */
subkind Sentar specializes HabilidadeMotora {
    label {
        @en "Sitting"
        @pt-br "Sentar"
    }
}


/**
 * @pt-br Representa a habilidade de engatinhar.
 */
subkind Engatinhar specializes HabilidadeMotora {
    label {
        @en "Crawling"
        @pt-br "Engatinhar"
    }
}


// ============================================================
// AVALIAÇÃO
// ============================================================

/**
 * @pt-br Representa a avaliação de uma habilidade de uma pessoa.
 *
 * A avaliação é modelada como um relator porque representa a relação
 * entre uma pessoa, uma habilidade e o resultado observado.
 *
 * @en Represents the assessment of a person's skill.
 */
relator AvaliacaoHabilidade {
    label {
        @en "Skill Assessment"
        @pt-br "Avaliação de Habilidade"
    }

    dataAvaliacao : date
    nivel : string

    @mediation [1] -- pertenceA -- [0..*] (pessoa) Pessoa

    @mediation [1] -- avalia -- [0..*] (habilidade) Habilidade
}


// ============================================================
// TRATAMENTOS
// ============================================================

/**
 * @pt-br Representa um tratamento disponível no contexto do sistema.
 *
 * @en Represents a treatment available in the system context.
 */
kind Tratamento {
    label {
        @en "Treatment"
        @pt-br "Tratamento"
    }

    nome : string
    descricao : string
}


// ============================================================
// RECOMENDAÇÃO
// ============================================================

/**
 * @pt-br Representa uma recomendação de tratamento produzida pelo sistema
 * com base nas avaliações das habilidades.
 *
 * @en Represents a treatment recommendation produced by the system
 * based on skill assessments.
 */
relator Recomendacao {
    label {
        @en "Recommendation"
        @pt-br "Recomendação"
    }

    dataRecomendacao : date
    justificativa : string
    prioridade : string

    @mediation [1] -- destinadaA -- [0..*] (pessoa) Pessoa

    @mediation [1] -- recomenda -- [0..*] (tratamento) Tratamento

    @mediation [1..*] -- baseadaEm -- [0..*] (avaliacao) AvaliacaoHabilidade
}

/**
 * @pt-br Representa um especialista no conhecimento utilizado pelo sistema.
 */
kind Especialista {
    label {
        @en "Specialist"
        @pt-br "Especialista"
    }

    [1] -- aplica -- [0..*] (conhecimento) Conhecimento
}

// ============================================================
// RELAÇÕES DE CONHECIMENTO
// ============================================================

// Uma habilidade pode estar associada a diferentes tratamentos.
// A relação representa o conhecimento utilizado pelas regras.
relator Conhecimento {
    [0..*] -- podeIndicar -- [0..*] (tratamento) Tratamento
}


// ============================================================
// TIPOS DE DADOS
// ============================================================

/**
 * @pt-br Representa o nível de desempenho observado em uma habilidade.
 */
enum NivelHabilidade {
    NaoAvaliado,
    Baixo,
    Moderado,
    Alto
}


/**
 * @pt-br Representa o nível de prioridade de uma recomendação.
 */
enum NivelPrioridade {
    Baixa,
    Media,
    Alta
}