inst:con_integrado a tcc:ConhecimentoComposto ;
    rdfs:label "Indica Intervenção integrada autocuidado + motor quando ≥ 2 conhecimentos requeridos atingem 30% (R5)"@pt-br ;
    tcc:limiarIndicacao 0.3 ;
    tcc:minimoRequeridos 2 ;
    tcc:podeIndicar inst:trat_integrado ;
    tcc:requer inst:con_autocuidado,
        inst:con_motor_fino,
        inst:con_motor_grosso .

inst:rel_CO01 a tcc:Composicao ;
    rdfs:label "CO01: Manuseio de ajustes é parte de Vestuário"@pt-br ;
    tcc:destino inst:hab_AC08 ;
    tcc:evidencia "Conteúdo do item" ;
    tcc:fundamentacao "Os itens de vestir do IPO ressalvam os fechos (A-54/A-58: 'exceto botões/zíper'; A-81: 'mas não dá laços'), ou seja, manusear ajustes é parte do vestir-se completo." ;
    tcc:origem inst:hab_AC09 ;
    tcc:pesoIndireto 0.5 ;
    tcc:statusValidacao "Derivada do IPO – validar com as orientadoras" .

inst:rel_PR02 a tcc:PreRequisito ;
    rdfs:label "PR02: Preensão é pré-requisito de Alimentação"@pt-br ;
    tcc:destino inst:hab_AC01 ;
    tcc:evidencia "Conteúdo do item + sequência etária" ;
    tcc:fundamentacao "Alimentar-se com os dedos (A-10) e com a colher (A-14) exige pegar o alimento ou o talher; a preensão vem antes ou na mesma faixa." ;
    tcc:origem inst:hab_MO06 ;
    tcc:pesoIndireto 0.5 ;
    tcc:statusValidacao "Derivada do IPO – validar com as orientadoras" .

inst:rel_PR04 a tcc:PreRequisito ;
    rdfs:label "PR04: Preensão é pré-requisito de Cuidado com o cabelo"@pt-br ;
    tcc:destino inst:hab_AC05 ;
    tcc:evidencia "Conteúdo do item + sequência etária" ;
    tcc:fundamentacao "Pentear ou escovar o cabelo (A-86) exige segurar o pente ou a escova." ;
    tcc:origem inst:hab_MO06 ;
    tcc:pesoIndireto 0.5 ;
    tcc:statusValidacao "Derivada do IPO – validar com as orientadoras" .

inst:rel_PR08 a tcc:PreRequisito ;
    rdfs:label "PR08: Preensão é pré-requisito de Encaixe de pinos e argolas"@pt-br ;
    tcc:destino inst:hab_MO07 ;
    tcc:evidencia "Conteúdo do item + sequência etária" ;
    tcc:fundamentacao "Colocar aros na estaca (M-50) e encaixar pinos (M-52) exige pegar objetos pequenos." ;
    tcc:origem inst:hab_MO06 ;
    tcc:pesoIndireto 0.5 ;
    tcc:statusValidacao "Derivada do IPO – validar com as orientadoras" .

inst:rel_PR09 a tcc:PreRequisito ;
    rdfs:label "PR09: Preensão é pré-requisito de Empilhar peças"@pt-br ;
    tcc:destino inst:hab_MO08 ;
    tcc:evidencia "Conteúdo do item + sequência etária" ;
    tcc:fundamentacao "Construir torre de blocos (M-53) exige segurar e soltar blocos (M-29)." ;
    tcc:origem inst:hab_MO06 ;
    tcc:pesoIndireto 0.5 ;
    tcc:statusValidacao "Derivada do IPO – validar com as orientadoras" .

inst:rel_PR11 a tcc:PreRequisito ;
    rdfs:label "PR11: Preensão é pré-requisito de Dobrar papel"@pt-br ;
    tcc:destino inst:hab_MO10 ;
    tcc:evidencia "Conteúdo do item + sequência etária" ;
    tcc:fundamentacao "Dobrar papel ao meio (M-73) exige pegar e alinhar a borda do papel com os dedos." ;
    tcc:origem inst:hab_MO06 ;
    tcc:pesoIndireto 0.5 ;
    tcc:statusValidacao "Derivada do IPO – validar com as orientadoras" .

inst:rel_PR12 a tcc:PreRequisito ;
    rdfs:label "PR12: Preensão é pré-requisito de Montagem de quebra-cabeças"@pt-br ;
    tcc:destino inst:hab_MO11 ;
    tcc:evidencia "Conteúdo do item + sequência etária" ;
    tcc:fundamentacao "Montar quebra-cabeça (M-81) exige pegar e posicionar as peças." ;
    tcc:origem inst:hab_MO06 ;
    tcc:pesoIndireto 0.5 ;
    tcc:statusValidacao "Derivada do IPO – validar com as orientadoras" .

inst:rel_PR14 a tcc:PreRequisito ;
    rdfs:label "PR14: Preensão é pré-requisito de Manipulação de fechos, trincos e maçanetas"@pt-br ;
    tcc:destino inst:hab_MO15 ;
    tcc:evidencia "Conteúdo do item + sequência etária" ;
    tcc:fundamentacao "Virar maçanetas (M-65) e desenroscar (M-75) exigem preensão do objeto." ;
    tcc:origem inst:hab_MO06 ;
    tcc:pesoIndireto 0.5 ;
    tcc:statusValidacao "Derivada do IPO – validar com as orientadoras" .

inst:rel_PR15 a tcc:PreRequisito ;
    rdfs:label "PR15: Equilíbrio estático é pré-requisito de Locomoção geral"@pt-br ;
    tcc:destino inst:hab_MO01 ;
    tcc:evidencia "Sequência etária" ;
    tcc:fundamentacao "Manter-se em pé sozinho por 1 minuto (M-37) antecede andar sozinho (M-55)." ;
    tcc:origem inst:hab_MO03 ;
    tcc:pesoIndireto 0.5 ;
    tcc:statusValidacao "Derivada do IPO – validar com as orientadoras" .

tcc:Alimentacao a gufo:SubKind,
        owl:Class ;
    rdfs:label "Feeding"@en,
        "Alimentação"@pt-br ;
    rdfs:subClassOf tcc:HabilidadeAutocuidado ;
    owl:disjointWith tcc:Calcados,
        tcc:HigieneBucal,
        tcc:HigieneCabelos,
        tcc:HigieneCorporal,
        tcc:HigieneMaos,
        tcc:HigieneRosto,
        tcc:UsoBanheiro,
        tcc:Vestuario .

tcc:Caminhar a gufo:SubKind,
        owl:Class ;
    rdfs:label "Walking"@en,
        "Caminhar"@pt-br ;
    rdfs:subClassOf tcc:HabilidadeMotora ;
    owl:disjointWith tcc:Correr,
        tcc:Engatinhar,
        tcc:Rolar,
        tcc:Sentar,
        tcc:SubirEscadas .

