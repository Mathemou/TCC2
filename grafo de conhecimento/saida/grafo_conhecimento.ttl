inst:rec_P001_1 a tcc:Recomendacao ;
    rdfs:label "Recomendação P001 nº1: Treino de habilidades de autocuidado"@pt-br ;
    tcc:baseadaEm inst:aval_P001_AC01,
        inst:aval_P001_AC02,
        inst:aval_P001_AC03,
        inst:aval_P001_AC04,
        inst:aval_P001_AC05,
        inst:aval_P001_AC06,
        inst:aval_P001_AC07,
        inst:aval_P001_AC08,
        inst:aval_P001_AC09,
        inst:aval_P001_AC10,
        inst:aval_P001_MO15 ;
    tcc:dataRecomendacao "2026-09-22"^^xsd:date ;
    tcc:destinadaA inst:pessoa_P001 ;
    tcc:justificativa "1º de 2 indicados; pontuação 58.9% = 16.5/28 (R3). Contribuições R1/R2: Alimentação: Realiza com auxílio (peso 1); Escovação: Não realiza (peso 2); Fio dental: Não realiza (peso 2); Cuidado com o corpo: Realiza com auxílio (peso 1); Cuidado com o cabelo: Não realiza (peso 2); Cuidado com o rosto: Realiza com auxílio (peso 1); Cuidado com as mãos: Realiza com auxílio (peso 1); Vestuário: Não realiza (peso 2); Manuseio de ajustes: Não realiza (peso 2); Tarefas de banheiro: Realiza com auxílio (peso 1); Cuidado com as mãos apoia Alimentação: Realiza com auxílio (peso indireto 0.5); Cuidado com as mãos apoia Fio dental: Realiza com auxílio (peso indireto 0.5); Manipulação de fechos, trincos e maçanetas apoia Vestuário: Realiza com auxílio (peso indireto 0.5)." ;
    tcc:pontuacao 0.5893 ;
    tcc:prioridade "Alta" ;
    tcc:recomenda inst:trat_autocuidado .

