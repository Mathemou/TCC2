<http://example.org/sigamaes/ontologia> a owl:Ontology ;
    rdfs:label "Ontologia SIGAMAES – recomendação de tratamentos para pessoas com TEA"@pt-br ;
    rdfs:comment "Tradução em gUFO do modelo OntoUML grafo.png/grafo.tonto. Elementos anotados com tcc:extensaoProposta=true não existem no diagrama original (ver grafo.corrigido.tonto)."@pt-br .

tcc:NivelHabilidade a rdfs:Datatype ;
    rdfs:comment "Valores permitidos: NaoAvaliado, Baixo, Moderado, Alto"@pt-br .

tcc:NivelPrioridade a rdfs:Datatype ;
    rdfs:comment "Valores permitidos: Baixa, Media, Alta"@pt-br .

tcc:aplica a owl:ObjectProperty ;
    rdfs:label "aplica" ;
    rdfs:domain tcc:Especialista ;
    rdfs:range tcc:Conhecimento .

tcc:avalia a owl:ObjectProperty ;
    rdfs:label "avalia" ;
    rdfs:domain tcc:AvaliacaoHabilidade ;
    rdfs:range tcc:Habilidade ;
    rdfs:subPropertyOf gufo:mediates .

tcc:baseadaEm a owl:ObjectProperty ;
    rdfs:label "baseadaEm" ;
    rdfs:domain tcc:Recomendacao ;
    rdfs:range tcc:AvaliacaoHabilidade ;
    rdfs:subPropertyOf gufo:mediates .

tcc:dataAvaliacao a owl:DatatypeProperty ;
    rdfs:label "dataAvaliacao" ;
    rdfs:comment "Atributo de AvaliacaoHabilidade"@pt-br ;
    rdfs:range xsd:date .

tcc:dataDeNascimento a owl:DatatypeProperty ;
    rdfs:label "dataDeNascimento" ;
    rdfs:comment "Atributo de Pessoa"@pt-br ;
    rdfs:range xsd:date .

tcc:dataRecomendacao a owl:DatatypeProperty ;
    rdfs:label "dataRecomendacao" ;
    rdfs:comment "Atributo de Recomendacao"@pt-br ;
    rdfs:range xsd:date .

tcc:descricao a owl:DatatypeProperty ;
    rdfs:label "descricao" ;
    rdfs:comment "Atributo de Tratamento"@pt-br ;
    rdfs:range xsd:string .

tcc:destinadaA a owl:ObjectProperty ;
    rdfs:label "destinadaA" ;
    rdfs:domain tcc:Recomendacao ;
    rdfs:range tcc:Pessoa ;
    rdfs:subPropertyOf gufo:mediates .

tcc:extensaoProposta a owl:AnnotationProperty .

tcc:habilidadeApoiada a owl:ObjectProperty ;
    rdfs:label "habilidadeApoiada" ;
    tcc:extensaoProposta true ;
    rdfs:comment "Habilidade que depende da habilidade base (R2)."@pt-br ;
    rdfs:domain tcc:DependenciaHabilidade ;
    rdfs:range tcc:Habilidade ;
    rdfs:subPropertyOf gufo:mediates .

tcc:habilidadeBase a owl:ObjectProperty ;
    rdfs:label "habilidadeBase" ;
    tcc:extensaoProposta true ;
    rdfs:domain tcc:DependenciaHabilidade ;
    rdfs:range tcc:Habilidade ;
    rdfs:subPropertyOf gufo:mediates .

tcc:identificador a owl:DatatypeProperty ;
    rdfs:label "identificador" ;
    rdfs:comment "Atributo de Prontuario"@pt-br ;
    rdfs:range xsd:string .

tcc:justificativa a owl:DatatypeProperty ;
    rdfs:label "justificativa" ;
    rdfs:comment "Atributo de Recomendacao (R4)"@pt-br ;
    rdfs:range xsd:string .

tcc:limiarIndicacao a owl:DatatypeProperty ;
    rdfs:label "limiarIndicacao" ;
    tcc:extensaoProposta true ;
    rdfs:comment "Conhecimento; pontuação mínima para indicar (R6) ou, no conhecimento composto, para cada conhecimento requerido (R5)"@pt-br ;
    rdfs:range xsd:decimal .

tcc:minimoRequeridos a owl:DatatypeProperty ;
    rdfs:label "minimoRequeridos" ;
    tcc:extensaoProposta true ;
    rdfs:comment "Conhecimento composto; quantos requeridos devem atingir o limiar (R5)"@pt-br ;
    rdfs:range xsd:integer .

tcc:nivel a owl:DatatypeProperty ;
    rdfs:label "nivel" ;
    rdfs:comment "AvaliacaoHabilidade; valores de NivelHabilidade"@pt-br ;
    rdfs:range xsd:string .

tcc:nome a owl:DatatypeProperty ;
    rdfs:label "nome" ;
    rdfs:comment "Atributo de Pessoa, Habilidade e Tratamento"@pt-br ;
    rdfs:range xsd:string .

tcc:pertenceA a owl:ObjectProperty ;
    rdfs:label "pertenceA" ;
    rdfs:domain tcc:AvaliacaoHabilidade ;
    rdfs:range tcc:Pessoa ;
    rdfs:subPropertyOf gufo:mediates .

tcc:pesoIndireto a owl:DatatypeProperty ;
    rdfs:label "pesoIndireto" ;
    tcc:extensaoProposta true ;
    rdfs:comment "DependenciaHabilidade (R2)"@pt-br ;
    rdfs:range xsd:decimal .

tcc:podeIndicar a owl:ObjectProperty ;
    rdfs:label "podeIndicar" ;
    rdfs:domain tcc:Conhecimento ;
    rdfs:range tcc:Tratamento ;
    rdfs:subPropertyOf gufo:mediates .

tcc:pontuacao a owl:DatatypeProperty ;
    rdfs:label "pontuacao" ;
    tcc:extensaoProposta true ;
    rdfs:comment "Recomendacao; pontuação normalizada 0–1 (R3/R5)"@pt-br ;
    rdfs:range xsd:decimal .

tcc:prioridade a owl:DatatypeProperty ;
    rdfs:label "prioridade" ;
    rdfs:comment "Recomendacao; valores de NivelPrioridade"@pt-br ;
    rdfs:range xsd:string .

tcc:recomenda a owl:ObjectProperty ;
    rdfs:label "recomenda" ;
    rdfs:domain tcc:Recomendacao ;
    rdfs:range tcc:Tratamento ;
    rdfs:subPropertyOf gufo:mediates .

tcc:refereSe a owl:ObjectProperty ;
    rdfs:label "refereSe" ;
    tcc:extensaoProposta true ;
    rdfs:comment "Habilidades cuja dificuldade pontua o tratamento (R1)."@pt-br ;
    rdfs:domain tcc:ConhecimentoSimples ;
    rdfs:range tcc:Habilidade ;
    rdfs:subPropertyOf gufo:mediates .

tcc:registra a owl:ObjectProperty ;
    rdfs:label "registra" ;
    tcc:extensaoProposta true ;
    rdfs:domain tcc:Prontuario ;
    rdfs:range tcc:Pessoa .

tcc:requer a owl:ObjectProperty ;
    rdfs:label "requer" ;
    tcc:extensaoProposta true ;
    rdfs:comment "Conhecimento composto: indica o tratamento quando os conhecimentos requeridos atingem o limiar (R5 – intervenção integrada)."@pt-br ;
    rdfs:domain tcc:ConhecimentoComposto ;
    rdfs:range tcc:ConhecimentoSimples .

