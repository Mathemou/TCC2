inst:esp_FISIO a tcc:Especialista ;
    rdfs:label "Fisioterapeuta (equipe AMAES – fictício)"@pt-br ;
    tcc:aplica inst:con_motor_grosso .

inst:esp_TO a tcc:Especialista ;
    rdfs:label "Terapeuta ocupacional (equipe AMAES – fictício)"@pt-br ;
    tcc:aplica inst:con_autocuidado,
        inst:con_integrado,
        inst:con_motor_fino .

