inst:inc_P002_CO02 a tcc:Inconsistencia ;
    rdfs:label "Inconsistência P002/CO02 (Moderada)"@pt-br ;
    tcc:avaliacaoDestino inst:aval_P002_AC10 ;
    tcc:avaliacaoOrigem inst:aval_P002_AC08 ;
    tcc:descricao "Tarefas de banheiro está como \"Independente\", mas a parte Vestuário está como \"Realiza com auxílio\"." ;
