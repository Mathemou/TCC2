    tcc:evidencia "Conteúdo do item" ;
    tcc:fundamentacao "A-85 define usar o banheiro de forma independente incluindo 'retira a roupa' e 'veste-se sem ajuda': vestir-se é parte da tarefa." ;
    tcc:origem inst:hab_AC08 ;
    tcc:pesoIndireto 0.5 ;
