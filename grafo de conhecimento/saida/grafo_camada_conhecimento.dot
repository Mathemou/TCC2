digraph conhecimento {
  graph [rankdir=LR, compound=true, fontname="Helvetica", nodesep=0.18, ranksep=1.0, label="Grafo de conhecimento — camada especialista (Especialista → Conhecimento → Tratamento / Habilidade)", labelloc=t, fontsize=18];
  node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box, color="#555555"];
  edge [fontname="Helvetica", fontsize=8, color="#666666"];
  esp_TO [label="«Especialista»\nTerapeuta ocupacional", fillcolor="#FF9AA2"];
  esp_FISIO [label="«Especialista»\nFisioterapeuta", fillcolor="#FF9AA2"];
  con_autocuidado [label="«ConhecimentoSimples»\ncon_autocuidado\nlimiar 15% (R6)", fillcolor="#9CF59C"];
  trat_autocuidado [label="«Tratamento»\nTreino de habilidades de autocuidado", fillcolor="#FF9AA2", penwidth=2];
  esp_TO -> con_autocuidado [label="aplica"];
  con_autocuidado -> trat_autocuidado [label="podeIndicar", color="#166534", penwidth=1.6];
  con_motor_grosso [label="«ConhecimentoSimples»\ncon_motor_grosso\nlimiar 15% (R6)", fillcolor="#9CF59C"];
  trat_motor_grosso [label="«Tratamento»\nTreino de habilidades motoras grossas", fillcolor="#FF9AA2", penwidth=2];
  esp_FISIO -> con_motor_grosso [label="aplica"];
  con_motor_grosso -> trat_motor_grosso [label="podeIndicar", color="#166534", penwidth=1.6];
  con_motor_fino [label="«ConhecimentoSimples»\ncon_motor_fino\nlimiar 15% (R6)", fillcolor="#9CF59C"];
  trat_motor_fino [label="«Tratamento»\nTreino de habilidades motoras finas", fillcolor="#FF9AA2", penwidth=2];
  esp_TO -> con_motor_fino [label="aplica"];
  con_motor_fino -> trat_motor_fino [label="podeIndicar", color="#166534", penwidth=1.6];
  con_integrado [label="«ConhecimentoComposto»\ncon_integrado\nrequer ≥ 2 com ≥ 30% (R5)", fillcolor="#9CF59C"];
  trat_integrado [label="«Tratamento»\nIntervenção integrada autocuidado + motor", fillcolor="#FF9AA2", penwidth=2];
  esp_TO -> con_integrado [label="aplica"];
  con_integrado -> trat_integrado [label="podeIndicar", color="#166534", penwidth=1.6];
  con_integrado -> con_autocuidado [label="requer", color="#7C3AED", fontcolor="#7C3AED", penwidth=1.6];
  con_integrado -> con_motor_grosso [label="requer", color="#7C3AED", fontcolor="#7C3AED", penwidth=1.6];
  con_integrado -> con_motor_fino [label="requer", color="#7C3AED", fontcolor="#7C3AED", penwidth=1.6];
  subgraph cluster_autocuidado { label="Habilidades de autocuidado (formulário)"; style="rounded,dashed"; color="#999999"; fontsize=11;
    hab_AC01 [label="AC01 – Alimentação\n«Alimentacao»", fillcolor="#FFD9DD"];
    hab_AC02 [label="AC02 – Escovação\n«HigieneBucal»", fillcolor="#FFD9DD"];
    hab_AC03 [label="AC03 – Fio dental\n«HigieneBucal»", fillcolor="#FFD9DD"];
    hab_AC04 [label="AC04 – Cuidado com o corpo\n«HigieneCorporal»", fillcolor="#FFD9DD"];
    hab_AC05 [label="AC05 – Cuidado com o cabelo\n«HigieneCabelos»", fillcolor="#FFD9DD"];
    hab_AC06 [label="AC06 – Cuidado com o rosto\n«HigieneRosto»", fillcolor="#FFD9DD"];
    hab_AC07 [label="AC07 – Cuidado com as mãos\n«HigieneMaos»", fillcolor="#FFD9DD"];
    hab_AC08 [label="AC08 – Vestuário\n«Vestuario»", fillcolor="#FFD9DD"];
    hab_AC09 [label="AC09 – Manuseio de ajustes\n«Calcados»", fillcolor="#FFD9DD"];
    hab_AC10 [label="AC10 – Tarefas de banheiro\n«UsoBanheiro»", fillcolor="#FFD9DD"];
  }
  con_autocuidado -> hab_AC06 [lhead=cluster_autocuidado, label="refereSe (todas)", style=dashed, color="#2563EB", fontcolor="#2563EB"];
  subgraph cluster_grosso { label="Habilidades motoras grossas (formulário)"; style="rounded,dashed"; color="#999999"; fontsize=11;
    hab_MO01 [label="MO01 – Locomoção geral\n«Caminhar»", fillcolor="#FFD9DD"];
    hab_MO02 [label="MO02 – Locomoção específica\n«SubirEscadas»", fillcolor="#FFD9DD"];
    hab_MO03 [label="MO03 – Equilíbrio estático\n«HabilidadeMotora»", fillcolor="#FFD9DD"];
    hab_MO04 [label="MO04 – Equilíbrio dinâmico\n«HabilidadeMotora»", fillcolor="#FFD9DD"];
    hab_MO05 [label="MO05 – Arremessar, receber, rolar e chutar bolas\n«HabilidadeMotora»", fillcolor="#FFD9DD"];
  }
  con_motor_grosso -> hab_MO03 [lhead=cluster_grosso, label="refereSe (todas)", style=dashed, color="#2563EB", fontcolor="#2563EB"];
  subgraph cluster_fino { label="Habilidades motoras finas (formulário)"; style="rounded,dashed"; color="#999999"; fontsize=11;
    hab_MO06 [label="MO06 – Preensão\n«HabilidadeMotora»", fillcolor="#FFD9DD"];
    hab_MO07 [label="MO07 – Encaixe de pinos e argolas\n«HabilidadeMotora»", fillcolor="#FFD9DD"];
    hab_MO08 [label="MO08 – Empilhar peças\n«HabilidadeMotora»", fillcolor="#FFD9DD"];
    hab_MO09 [label="MO09 – Enfiagem de contas\n«HabilidadeMotora»", fillcolor="#FFD9DD"];
    hab_MO10 [label="MO10 – Dobrar papel\n«HabilidadeMotora»", fillcolor="#FFD9DD"];
    hab_MO11 [label="MO11 – Montagem de quebra-cabeças\n«HabilidadeMotora»", fillcolor="#FFD9DD"];
    hab_MO12 [label="MO12 – Preensão e controle de lápis\n«HabilidadeMotora»", fillcolor="#FFD9DD"];
    hab_MO13 [label="MO13 – Escrita, cópia de letras e desenho\n«HabilidadeMotora»", fillcolor="#FFD9DD"];
    hab_MO14 [label="MO14 – Uso de tesoura\n«HabilidadeMotora»", fillcolor="#FFD9DD"];
    hab_MO15 [label="MO15 – Manipulação de fechos, trincos e maçanetas\n«HabilidadeMotora»", fillcolor="#FFD9DD"];
  }
  con_motor_fino -> hab_MO11 [lhead=cluster_fino, label="refereSe (todas)", style=dashed, color="#2563EB", fontcolor="#2563EB"];
  subgraph cluster_extra { label="Subkinds sem item no formulário"; style="rounded,dotted"; color="#999999"; fontsize=11;
    hab_EX01 [label="EX01 – Correr\n«Correr»", fillcolor="#FFD9DD"];
    hab_EX02 [label="EX02 – Rolar\n«Rolar»", fillcolor="#FFD9DD"];
    hab_EX03 [label="EX03 – Sentar\n«Sentar»", fillcolor="#FFD9DD"];
    hab_EX04 [label="EX04 – Engatinhar\n«Engatinhar»", fillcolor="#FFD9DD"];
  }
  hab_AC07 -> hab_AC01 [label="dep_01 apoia", color="#B45309", fontcolor="#B45309", constraint=false];
  hab_AC07 -> hab_AC03 [label="dep_02 apoia", color="#B45309", fontcolor="#B45309", constraint=false];
  hab_MO06 -> hab_AC01 [label="dep_03 apoia", color="#B45309", fontcolor="#B45309", constraint=false];
  hab_MO06 -> hab_AC08 [label="dep_04 apoia", color="#B45309", fontcolor="#B45309", constraint=false];
  hab_MO01 -> hab_AC10 [label="dep_05 apoia", color="#B45309", fontcolor="#B45309", constraint=false];
  hab_MO01 -> hab_AC08 [label="dep_06 apoia", color="#B45309", fontcolor="#B45309", constraint=false];
  hab_MO04 -> hab_MO02 [label="dep_07 apoia", color="#B45309", fontcolor="#B45309", constraint=false];
  hab_MO03 -> hab_AC08 [label="dep_08 apoia", color="#B45309", fontcolor="#B45309", constraint=false];
  hab_MO12 -> hab_MO13 [label="dep_09 apoia", color="#B45309", fontcolor="#B45309", constraint=false];
  hab_MO06 -> hab_MO07 [label="dep_10 apoia", color="#B45309", fontcolor="#B45309", constraint=false];
  hab_MO06 -> hab_MO09 [label="dep_11 apoia", color="#B45309", fontcolor="#B45309", constraint=false];
  hab_MO06 -> hab_MO14 [label="dep_12 apoia", color="#B45309", fontcolor="#B45309", constraint=false];
  hab_MO15 -> hab_AC08 [label="dep_13 apoia", color="#B45309", fontcolor="#B45309", constraint=false];
}